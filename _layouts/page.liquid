---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
    <h1
      class="post-title"
      {% if page.i18n_key %}
        data-i18n="pages.{{ page.i18n_key }}.title"
      {% endif %}
    >
      {{ page.title }}
    </h1>
    <p
      class="post-description"
      {% if page.i18n_key %}
        data-i18n="pages.{{ page.i18n_key }}.description"
      {% endif %}
    >
      {{ page.description }}
    </p>
  </header>

  <article>
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
